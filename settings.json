{
    "editor.fontLigatures": true,
    "editor.fontFamily": "Cartograph CF",
    "window.zoomLevel": 2,
    
    "workbench.colorTheme": "Bearded Theme Solarized Light",
    "workbench.iconTheme": "bearded-icons",
    "editor.formatOnPaste": true,
    "workbench.colorCustomizations": {
        "[Bearded Theme Solarized Light]": {
            "editor.background": "#fffbee", // keep text readable
            "editorGutter.background": "#fffbee"
        }
    },

    "editor.lineNumbers": "on",
    "editor.glyphMargin": true,
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "storage.modifier",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "comment",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "keyword",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "string",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "constant.numeric",
                "settings": {
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "support.function",
                "settings": {
                    "fontStyle": "italic"
                }
            }
        ]
    },
    "claudeCode.preferredLocation": "panel",
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "workbench.editorAssociations": {
        "*.copilotmd": "vscode.markdown.preview.editor",
        "*.html": "default"
    },
    "markdown-preview-enhanced.chromePath": "/usr/bin/chromium-browser",
    "markdown-preview-enhanced.breakOnSingleNewLine": false
}
